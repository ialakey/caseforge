// Every monetary amount is an integer in minor units. Never a Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  /// Migrations and introspection bypass the connection pooler. They open long
  /// sessions, create types and take locks that transaction pooling cannot
  /// carry across statements, so `url` may point at PgBouncer while this points
  /// at Postgres itself. Defaults to DATABASE_URL when nobody set it.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  USER
  ANALYST
  SUPPORT
  ADMIN
}

enum ItemRarity {
  CONSUMER
  INDUSTRIAL
  MILSPEC
  RESTRICTED
  CLASSIFIED
  COVERT
  EXTRAORDINARY
}

enum InventoryItemStatus {
  AVAILABLE // sitting in the site inventory
  LOCKED // reserved for a withdrawal, must not change
  WITHDRAWN // handed to the player in Steam
  SOLD // sold back to the site for balance
  UPGRADED // staked in an upgrade and consumed regardless of the outcome
  CONTRACTED // thrown into a contract and consumed regardless of the outcome
}

enum TransactionType {
  DEPOSIT
  /// Balance that arrived as skins rather than as money. Kept apart from
  /// DEPOSIT so a report can say what the item channel is worth on its own —
  /// it has a different margin and a different risk, and a single line that
  /// mixed the two could describe neither.
  ITEM_DEPOSIT
  WITHDRAWAL_REFUND
  CASE_OPEN
  ITEM_SELL
  ADMIN_ADJUSTMENT
  BONUS
  /// A seat in a case battle. Economically a case purchase, kept apart so a
  /// report can tell how much of the turnover the lobby brings in.
  BATTLE_ENTRY
  /// A battle that never filled, given back in full.
  BATTLE_REFUND
  /// A referral commission paid out of the pending pot onto the balance.
  REFERRAL
}

enum UpgradeStatus {
  WON
  LOST
}

enum PromoKind {
  PERCENT // a share of the deposit, in basis points
  FIXED // a flat credit in minor units
}

enum BonusKind {
  BALANCE // credited to the balance
  DISCOUNT // a cut off the next opening, in basis points
  FREE_CASE // one free opening up to a price ceiling
  FREE_ITEM // a skin up to a price ceiling
}

/// Where a deposit of items has got to.
///
/// Mirrors the withdrawal states rather than inventing its own vocabulary: the
/// two are the same trade, run in opposite directions, and an operator reading
/// both lists should not have to learn two sets of words for "the offer is with
/// the player".
/// How far a money top-up has got.
///
/// Deliberately short. A payment provider has a dozen intermediate states and
/// none of them changes what this site does: either the money arrived and the
/// balance moves, or it did not.
enum PaymentStatus {
  PENDING // created with the provider; the player is at their checkout
  SUCCEEDED // confirmed and credited
  FAILED // the provider said no
  CANCELLED // abandoned by the player, or expired
}

enum ItemDepositStatus {
  PENDING // created; no bot has picked it up yet
  OFFER_SENT // a bot has asked the player for the items
  ACCEPTED // the player handed them over and the bot holds them
  CREDITED // the balance has been credited — the only success
  DECLINED // the player refused the offer or let it expire
  FAILED // something broke; nothing was credited
  CANCELLED // withdrawn by the player or an operator before it was accepted
}

enum WithdrawalStatus {
  PENDING // accepted, waiting to be picked up
  PROCESSING // being bought on the market, or a bot is building the offer
  SENT // in flight: bought and awaiting the seller, or the offer is with the player
  COMPLETED // every item reached the player
  PARTIAL // some items were delivered and some were refunded
  FAILED // nothing was delivered, items returned
  CANCELLED // cancelled by the player or an operator
}

/// How a request is filled.
///
/// Stamped on the request when it is made rather than read from the settings
/// when it is processed: an operator flipping the channel must not leave the
/// requests already in flight being polled by the wrong half of the worker.
enum WithdrawalProvider {
  MARKET // bought on market.csgo.com and delivered by the seller
  BOTS // handed out of the Steam bot farm's own inventory
}

enum BattleStatus {
  WAITING // created and paid for by the host, seats still open
  RUNNING // full; the rounds are being rolled. A very short state
  FINISHED
  CANCELLED // abandoned before it filled — every seat refunded
}

enum BattleMode {
  STANDARD // the biggest total takes everything
  CRAZY // the smallest total takes everything
}

enum ReferralEarningKind {
  DEPOSIT // a share of a top-up the invited player made
  WAGER // a share of the case prices they opened, battles included
}

enum MarketAccountStatus {
  OFFLINE // registered, not checked yet
  ONLINE // answering and able to buy
  DISABLED // taken out of rotation by an operator
  ERROR // the market refused it: bad key, ban, wrong currency
}

enum MarketPurchaseStatus {
  PENDING // row exists, nothing has been bought or paid for yet
  BOUGHT // paid for; the seller has yet to deliver
  DELIVERED // the item is in the player's Steam inventory
  FAILED // never bought, or bought and then cancelled with a refund
}

enum BotStatus {
  OFFLINE
  ONLINE
  BUSY
  DISABLED
  ERROR
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  steamId64 String   @unique
  username  String
  avatarUrl String?
  tradeUrl  String?
  role      UserRole @default(USER)

  /// Denormalised cache; the source of truth is the sum of Transaction.amount.
  /// A nightly cron checks that they agree.
  balance Int @default(0)

  isBanned  Boolean @default(false)
  banReason String?

  /// The player's own invite code. Nullable because accounts created before
  /// referrals existed have none; it is minted on the first read rather than
  /// backfilled, so an account that never opens the referral page never gets
  /// a code it does not use.
  referralCode String? @unique

  /// When the daily wheel was last span. Denormalised on purpose: the cooldown
  /// is claimed with a conditional UPDATE on this column, which is what makes
  /// two simultaneous spins impossible without a lock.
  lastBonusAt DateTime?

  /// Groundwork for KYC and geo — filled in at stage 4, but the columns exist
  /// now so the live users table does not need migrating later.
  isVerified  Boolean @default(false)
  countryCode String? @db.Char(2)

  registrationIp String?
  lastLoginIp    String?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serverSeeds  ServerSeed[]
  clientSeeds  ClientSeed[]
  openings     CaseOpening[]
  inventory    InventoryItem[]
  transactions Transaction[]
  withdrawals  Withdrawal[]
  itemDeposits ItemDeposit[]
  payments     Payment[]
  upgrades     Upgrade[]
  contracts    Contract[]
  bonuses      DailyBonus[]
  promoUses    PromoRedemption[]
  auditLogs    AuditLog[]      @relation("AuditActor")

  battlesHosted Battle[]       @relation("BattleHost")
  battlesWon    Battle[]       @relation("BattleWinner")
  battleSeats   BattlePlayer[]

  /// The players this account invited, and the one invite it was itself
  /// bound to. The second side is a single row on purpose: one inviter per
  /// player, set once at sign-up and never edited.
  invited   Referral[] @relation("ReferralInviter")
  invitedBy Referral?  @relation("ReferralInvitee")

  referralEarnings ReferralEarning[] @relation("ReferralEarner")
  referralSourced  ReferralEarning[] @relation("ReferralSource")

  analyticsEvents AnalyticsEvent[]

  @@index([createdAt])
  @@index([role])
  @@map("users")
}

model Item {
  id String @id @default(uuid()) @db.Uuid

  /// Steam key: the exact market name. Unique, and the join key for price sync.
  marketHashName String     @unique
  name           String
  imageUrl       String?
  rarity         ItemRarity
  weaponType     String?
  exterior       String?

  /// The effective price resolves as priceOverride ?? marketPrice.
  marketPrice    Int       @default(0)
  priceOverride  Int?
  priceUpdatedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseItems       CaseItem[]
  inventoryItems  InventoryItem[]
  openings        CaseOpening[]
  botItems        BotInventoryItem[]
  upgradeTargets  Upgrade[]          @relation("UpgradeTarget")
  contractRewards Contract[]         @relation("ContractRewardItem")
  bonusGrants     DailyBonus[]       @relation("BonusItem")
  marketPurchases MarketPurchase[]
  withdrawalLines WithdrawalItem[]
  depositLines    ItemDepositItem[]

  @@index([rarity])
  @@index([isActive])
  /// The price-band scans: a contract's reward pool and the wheel's free-skin
  /// slice both ask for active items inside a price range, and that range can
  /// span fiftyfold. Without this the planner walks the whole catalogue on
  /// every contract preview.
  @@index([isActive, marketPrice])
  @@map("items")
}

/// A shelf in the catalogue: "free cases", "by rarity", "collections".
///
/// A flat list of two hundred cases is not a catalogue, it is a wall. The
/// grouping is data rather than an enum because it is merchandising — an
/// operator adds a shelf for a holiday and removes it afterwards, and neither
/// should be a deploy.
model CaseCategory {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique

  /// Display name in the base locale (Russian), and its English counterpart.
  /// Nullable for the same reason `Case.nameEn` is: an untranslated shelf reads
  /// worse than a translated one and far better than an empty heading.
  name   String
  nameEn String?

  /// Where the shelf sits on the page. Shelves are ordered by an operator's
  /// idea of importance, which no derived value can guess.
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]

  @@index([isActive, sortOrder])
  @@map("case_categories")
}

model Case {
  id     String @id @default(uuid()) @db.Uuid
  slug   String @unique

  /// Display name in the base locale (Russian).
  name String

  /// English display name. Nullable on purpose: a case created before the
  /// English catalogue existed simply falls back to `name`, which reads worse
  /// than a translation but far better than an empty title.
  nameEn String?

  /// A sentence or two under the title: what is in the case and what the best
  /// outcome looks like. Nullable because a case without a description is a
  /// case with a quieter page, not a broken one.
  description   String?
  descriptionEn String?

  price     Int
  imageUrl  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// A free case: it costs nothing, and what rations it is a deposit
  /// requirement and a cooldown rather than a price.
  ///
  /// A flag rather than an inference from `price == 0`, because the two are
  /// different claims. A price of zero is an accident waiting to happen — a
  /// mis-typed field, a solver that clamped — and it would silently turn a
  /// paid case into a giveaway. This has to be switched on deliberately.
  isFree Boolean @default(false)

  /// How much the player must have topped up over the last 24 hours to unlock
  /// it, in minor units. Zero means anyone may open it.
  ///
  /// A rolling window rather than a lifetime total: the point of a free case
  /// is to reward topping up now, and a player who deposited once a year ago
  /// should not collect a knife every day forever on the strength of it.
  freeMinDeposit Int @default(0)

  /// How many times it may be opened within a rolling 24 hours.
  freeMaxOpens Int @default(1)

  /// Which shelf it sits on. Nullable: a case without a category is not a
  /// broken case, it is an ungrouped one, and it still has to render.
  categoryId String? @db.Uuid

  /// RTP cached at the last recalculation, so listing pages need not recompute it.
  rtpCached       Float?
  rtpCalculatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       CaseItem[]
  openings    CaseOpening[]
  battleLines BattleCase[]
  category    CaseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([categoryId, sortOrder])
  @@map("cases")
}

model CaseItem {
  id     String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  itemId String @db.Uuid

  /// Ticket range within [0, 999999], bounds inclusive.
  /// The ranges of all items in a case must cover the space with no gaps and
  /// no overlaps — validateTicketRanges enforces this on save.
  rangeFrom Int
  rangeTo   Int

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([caseId, itemId])
  @@index([caseId, rangeFrom])
  @@map("case_items")
}

model ServerSeed {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// The seed is always stored — the server needs it to compute the roll.
  /// It is only exposed after rotation (isActive = NULL, revealedAt set);
  /// while the seed is active the API returns nothing but seedHash.
  seed     String
  seedHash String

  nonce Int @default(0)

  /// true = active, NULL = retired. Nullable on purpose: in Postgres NULLs do
  /// not collide in a unique index, so the (userId, isActive) pair yields
  /// exactly one active seed per user without capping the retired ones.
  isActive Boolean?

  createdAt  DateTime  @default(now())
  revealedAt DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  openings  CaseOpening[]
  upgrades  Upgrade[]
  contracts Contract[]
  bonuses   DailyBonus[]

  @@unique([userId, isActive], map: "server_seeds_one_active_per_user")
  @@index([userId])
  @@map("server_seeds")
}

model ClientSeed {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  seed   String

  /// See the note on ServerSeed.isActive.
  isActive Boolean?

  createdAt DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  openings  CaseOpening[]
  upgrades  Upgrade[]
  contracts Contract[]
  bonuses   DailyBonus[]

  @@unique([userId, isActive], map: "client_seeds_one_active_per_user")
  @@index([userId])
  @@map("client_seeds")
}

model CaseOpening {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  caseId String @db.Uuid
  itemId String @db.Uuid

  serverSeedId String @db.Uuid
  clientSeedId String @db.Uuid
  nonce        Int
  roll         Int

  /// Prices at the moment of opening, so reports do not shift when items are re-priced.
  casePrice Int
  itemPrice Int

  /// The battle this opening belongs to, and which of its rounds it was.
  ///
  /// A battle drop is not a separate kind of event: it is an opening like any
  /// other, paid for at the list price and rolled from the opening player's own
  /// seed pair. Recording it here rather than in a table of its own is what
  /// keeps one set of numbers — the RTP report, the drop feed and the player's
  /// own verifiable history all pick battles up without knowing about them.
  /// The item itself may well end up in somebody else's inventory, which is
  /// the only thing a battle actually changes.
  battleId    String? @db.Uuid
  battleRound Int?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  case       Case       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  serverSeed ServerSeed @relation(fields: [serverSeedId], references: [id], onDelete: Restrict)
  clientSeed ClientSeed @relation(fields: [clientSeedId], references: [id], onDelete: Restrict)
  battle     Battle?    @relation(fields: [battleId], references: [id], onDelete: Cascade)

  inventoryItem InventoryItem?

  /// Guards against a double opening on retry: the (seed, nonce) pair is unique.
  @@unique([serverSeedId, nonce])
  @@index([userId, createdAt])
  @@index([caseId, createdAt])
  @@index([createdAt])
  /// The free-case cooldown: how many times this player opened this one case
  /// in the last 24 hours. Asked on every visit to a free case's page, and
  /// neither of the indexes above narrows by both columns.
  @@index([userId, caseId, createdAt])
  /// The battle view's only read: every drop in one battle, in play order.
  @@index([battleId, battleRound])
  @@map("case_openings")
}

model InventoryItem {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  itemId String @db.Uuid

  status InventoryItemStatus @default(AVAILABLE)

  /// Price at the time of acquisition — the sell-back value is computed from it.
  acquiredPrice Int

  openingId    String? @unique @db.Uuid
  withdrawalId String? @db.Uuid

  /// The upgrade this item was staked in (for a consumed stake) or won from
  /// (for a reward).
  upgradeStakeId  String? @unique @db.Uuid
  upgradeRewardId String? @unique @db.Uuid

  /// The contract this item was thrown into, or won from. The stake side is
  /// deliberately not unique — a contract consumes several items at once,
  /// which is the one thing that makes it different from an upgrade.
  contractStakeId  String? @db.Uuid
  contractRewardId String? @unique @db.Uuid

  /// The wheel spin that granted this item, for a FREE_ITEM prize.
  bonusRewardId String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  soldAt    DateTime?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  opening    CaseOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)
  withdrawal Withdrawal?  @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  upgradeStake  Upgrade? @relation("UpgradeStake", fields: [upgradeStakeId], references: [id], onDelete: SetNull)
  upgradeReward Upgrade? @relation("UpgradeReward", fields: [upgradeRewardId], references: [id], onDelete: SetNull)

  contractStake  Contract? @relation("ContractStake", fields: [contractStakeId], references: [id], onDelete: SetNull)
  contractReward Contract? @relation("ContractReward", fields: [contractRewardId], references: [id], onDelete: SetNull)

  bonusReward DailyBonus? @relation("BonusReward", fields: [bonusRewardId], references: [id], onDelete: SetNull)

  /// The market purchase that delivered this item, when it left through the
  /// market channel rather than the bot farm.
  marketPurchase MarketPurchase?

  /// Every request this item has ever been part of, including the ones that
  /// gave it back.
  withdrawalLines WithdrawalItem[]

  @@index([userId, status])
  @@index([withdrawalId])
  @@index([contractStakeId])
  @@map("inventory_items")
}

/// Upgrade: the player stakes an item against a pricier one.
model Upgrade {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @db.Uuid
  status UpgradeStatus

  /// The target item — the one the player was trying to win.
  targetItemId String @db.Uuid

  /// Prices at the moment of the upgrade: the chance was computed from them
  /// and they must not drift when items are re-priced.
  stakeValue  Int
  targetValue Int

  /// Win chance and the ticket threshold — together with the roll they make
  /// the outcome fully verifiable.
  chance       Float
  winThreshold Int
  roll         Int

  serverSeedId String @db.Uuid
  clientSeedId String @db.Uuid
  nonce        Int

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetItem Item       @relation("UpgradeTarget", fields: [targetItemId], references: [id], onDelete: Restrict)
  serverSeed ServerSeed @relation(fields: [serverSeedId], references: [id], onDelete: Restrict)
  clientSeed ClientSeed @relation(fields: [clientSeedId], references: [id], onDelete: Restrict)

  stake  InventoryItem? @relation("UpgradeStake")
  reward InventoryItem? @relation("UpgradeReward")

  /// The same replay protection a case opening has.
  @@unique([serverSeedId, nonce])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("upgrades")
}

/// Contract: the player throws several items in and gets exactly one back.
model Contract {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// How many items went in, and what they were worth in total. Stored rather
  /// than recomputed from the staked rows: an item may later be deleted or
  /// re-priced, and the contract must still explain itself.
  stakeCount Int
  stakeValue Int

  /// The expected reward the outcome table was solved for — stakeValue times
  /// the contract RTP. Keeping it makes a drift in the margin visible in a
  /// report without replaying the solver.
  targetValue Int

  rewardItemId String @db.Uuid
  rewardValue  Int

  /// The full outcome table with its ticket ranges, exactly as it was played.
  /// The pool is derived from a live catalogue, so it cannot be rebuilt later
  /// from prices that have since moved; without this snapshot the roll would
  /// be reproducible but meaningless.
  outcomes Json

  roll Int

  serverSeedId String @db.Uuid
  clientSeedId String @db.Uuid
  nonce        Int

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItem Item       @relation("ContractRewardItem", fields: [rewardItemId], references: [id], onDelete: Restrict)
  serverSeed ServerSeed @relation(fields: [serverSeedId], references: [id], onDelete: Restrict)
  clientSeed ClientSeed @relation(fields: [clientSeedId], references: [id], onDelete: Restrict)

  stakes InventoryItem[] @relation("ContractStake")
  reward InventoryItem?  @relation("ContractReward")

  /// The same replay protection an opening and an upgrade have.
  @@unique([serverSeedId, nonce])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("contracts")
}

/// One spin of the daily wheel.
model DailyBonus {
  id     String    @id @default(uuid()) @db.Uuid
  userId String    @db.Uuid
  kind   BonusKind

  /// Which slice came up, by its stable key rather than its index: reordering
  /// the wheel later must not re-label what somebody won last month.
  segmentKey String

  /// Meaning follows the kind — minor units for BALANCE, basis points for
  /// DISCOUNT, a price ceiling for FREE_CASE and FREE_ITEM.
  value Int

  /// The item a FREE_ITEM spin turned into, priced at the moment it was granted.
  itemId    String? @db.Uuid
  itemPrice Int?

  /// The same seed pair, nonce and roll a case opening records, so a spin is
  /// checked exactly the way a drop is.
  serverSeedId String @db.Uuid
  clientSeedId String @db.Uuid
  nonce        Int
  roll         Int

  /// Vouchers — a discount, a free opening — sit here until they are spent.
  /// BALANCE and FREE_ITEM are settled at spin time and land already consumed.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item?      @relation("BonusItem", fields: [itemId], references: [id], onDelete: Restrict)
  serverSeed ServerSeed @relation(fields: [serverSeedId], references: [id], onDelete: Restrict)
  clientSeed ClientSeed @relation(fields: [clientSeedId], references: [id], onDelete: Restrict)

  reward InventoryItem? @relation("BonusReward")

  /// The same replay protection an opening, an upgrade and a contract have.
  @@unique([serverSeedId, nonce])
  @@index([userId, createdAt])
  /// Finding the vouchers an opening may spend is the hot read on this table.
  @@index([userId, consumedAt])
  @@map("daily_bonuses")
}

/// A promo code that tops the balance up alongside a deposit.
model PromoCode {
  id   String    @id @default(uuid()) @db.Uuid
  /// Stored upper-cased; the lookup upper-cases too, so the player may type it
  /// however they like.
  code String    @unique
  kind PromoKind

  /// Basis points for PERCENT, minor units for FIXED.
  value Int

  /// Smallest deposit the code applies to.
  minDeposit Int  @default(0)
  /// Cap on a percentage bonus; null means uncapped.
  maxBonus   Int?

  /// Total redemptions allowed; null means unlimited.
  maxUses Int?
  /// Denormalised counter, incremented in the same transaction as the
  /// redemption row. The rows remain the source of truth; this exists so the
  /// limit can be enforced with a conditional UPDATE instead of a count.
  usedCount Int @default(0)

  /// How many times one player may use it.
  perUserLimit Int @default(1)

  isActive Boolean   @default(true)
  startsAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoRedemption[]

  @@index([isActive, expiresAt])
  @@map("promo_codes")
}

/// One use of a promo code by one player.
model PromoRedemption {
  id          String @id @default(uuid()) @db.Uuid
  promoCodeId String @db.Uuid
  userId      String @db.Uuid

  /// What the deposit was and what the code added, both at the time.
  depositAmount Int
  bonusAmount   Int

  createdAt DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([userId, createdAt])
  @@map("promo_redemptions")
}

/// One case battle: the same list of cases, opened by several players at once.
///
/// The row is the agreement, not the outcome. What actually happened lives in
/// the `CaseOpening` rows that point back here — a battle stores only what the
/// openings cannot say for themselves: how many seats there were, what one cost,
/// and which of them ended up with the items.
model Battle {
  id     String       @id @default(uuid()) @db.Uuid
  hostId String       @db.Uuid
  status BattleStatus @default(WAITING)
  mode   BattleMode   @default(STANDARD)

  slots Int

  /// Denormalised seat counter. The seats are the `players` rows, and they
  /// remain the source of truth; this exists so a join can be claimed with a
  /// conditional UPDATE instead of counting rows and then inserting — between
  /// a count and an insert two players fired together both see the last seat
  /// free and both take it.
  filledSlots Int @default(0)

  /// Rounds and the price of one seat, both fixed when the battle is created.
  /// Stored rather than recomputed from the case list: a case re-priced while
  /// the battle waits must not change what the people already in it agreed to.
  rounds     Int
  entryPrice Int

  /// What everything dropped was worth, and who took it. Null until it is played.
  totalValue Int?
  winnerId   String? @db.Uuid

  /// Why it was called off — an operator switching battles off, the sweeper, or
  /// the host changing their mind.
  cancelReason String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  host   User  @relation("BattleHost", fields: [hostId], references: [id], onDelete: Cascade)
  winner User? @relation("BattleWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  cases    BattleCase[]
  players  BattlePlayer[]
  openings CaseOpening[]

  /// The lobby's read: everything still open, newest first.
  @@index([status, createdAt])
  @@index([hostId, createdAt])
  @@map("battles")
}

/// One line of a battle's case list: a case and how many rounds it is worth.
model BattleCase {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  caseId   String @db.Uuid

  /// Where the line sits in the list. The order is the host's and is visible in
  /// the lobby before anyone pays, so it is stored rather than sorted: a battle
  /// whose rounds were silently reordered is a different battle from the one
  /// people joined.
  position Int
  count    Int

  /// The list price at the moment the battle was created — the same figure
  /// `entryPrice` was summed from.
  price Int

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([battleId, position])
  /// A case appears once per battle; a second round of it is `count`, not a
  /// second line, or the two would disagree about how many rounds it is worth.
  @@unique([battleId, caseId])
  @@map("battle_cases")
}

/// One seat in a battle.
model BattlePlayer {
  id       String @id @default(uuid()) @db.Uuid
  battleId String @db.Uuid
  userId   String @db.Uuid

  /// 1-based, in the order the seats were taken. It is also the tiebreak of
  /// last resort, which is why it has to be stable.
  slot Int

  /// The sum of this seat's drops, written when the battle is settled.
  totalValue Int     @default(0)
  isWinner   Boolean @default(false)

  joinedAt DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One seat per player: a battle against yourself is not a battle.
  @@unique([battleId, userId])
  @@unique([battleId, slot])
  @@index([userId, joinedAt])
  @@map("battle_players")
}

/// Who invited whom. Written once, at the moment the invite is applied.
model Referral {
  id         String @id @default(uuid()) @db.Uuid
  referrerId String @db.Uuid

  /// Unique, and that uniqueness is the whole rule: one inviter per player,
  /// forever. Re-pointing a referral is a support ticket, not a feature.
  refereeId String @unique @db.Uuid

  /// The code as it was used. Denormalised because the inviter may rename their
  /// code later, and a binding has to keep explaining itself.
  code String

  /// The invited account registered from the same address as the inviter. Not a
  /// refusal — households and mobile carriers share addresses — but the classic
  /// shape of a self-referral, so it is flagged for an operator to judge.
  sameIp Boolean @default(false)

  createdAt DateTime @default(now())

  referrer User @relation("ReferralInviter", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralInvitee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@map("referrals")
}

/// One commission accrual.
///
/// Money the inviter has earned but has not been paid: it is not on any balance
/// and not in the ledger until it is claimed. That is deliberate — a commission
/// on every opening would otherwise mean a `Transaction` row per opening per
/// inviter, and the ledger is what the nightly reconciliation walks. Accruing
/// here and paying out in one entry keeps the ledger proportional to the number
/// of payouts rather than to the number of drops.
model ReferralEarning {
  id         String              @id @default(uuid()) @db.Uuid
  referrerId String              @db.Uuid
  refereeId  String              @db.Uuid
  kind       ReferralEarningKind

  /// What it was charged on, the rate at the time, and the result. The rate is
  /// stored because it is a setting: an operator lowering it must not rewrite
  /// what was already earned.
  sourceAmount Int
  rateBps      Int
  amount       Int

  /// The opening, battle or deposit that produced it.
  referenceId String?

  /// Null while it is still pending; set when it is paid onto the balance.
  claimedAt DateTime?

  createdAt DateTime @default(now())

  referrer User @relation("ReferralEarner", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralSource", fields: [refereeId], references: [id], onDelete: Cascade)

  /// The payout's hot read: everything this inviter is still owed.
  @@index([referrerId, claimedAt])
  @@index([referrerId, createdAt])
  @@index([refereeId, createdAt])
  @@map("referral_earnings")
}

/// One thing a browser did that the rest of the database cannot tell us.
///
/// Deliberately narrow. Everything that moved money is already a row with an
/// amount and a timestamp, and re-emitting it here would create a second set of
/// numbers that can disagree with the ledger. What is *only* knowable from the
/// browser is what this table holds: that somebody arrived, where from, what
/// they looked at, and where they stopped.
///
/// No IP address and no user agent are stored. The stream is about behaviour,
/// not identity, and neither field answers a question about behaviour that
/// `device` does not — while both would turn a traffic report into a store of
/// personal data.
model AnalyticsEvent {
  id   String @id @default(uuid()) @db.Uuid
  type String

  /// Stable per browser, generated by the client. Not an identity: it is what
  /// makes "visitors" a different number from "page views", and it is replaced
  /// whenever the browser forgets it.
  anonId String
  /// Restarts after a gap of inactivity, which is what makes sessions countable.
  sessionId String

  /// Filled in when the request carried a token, so the funnel can join the
  /// anonymous top to the signed-in bottom.
  userId String? @db.Uuid

  path     String?
  referrer String?

  /// Where the visitor came from, as the link said. Stored per event rather
  /// than per session because the first touch is the one worth attributing and
  /// it arrives on the first event.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// desktop / mobile / tablet, derived from the request header and stored
  /// instead of it.
  device String?

  meta Json?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([anonId, createdAt])
  @@index([userId, createdAt])
  @@index([utmSource, createdAt])
  @@map("analytics_events")
}

/// One metric, one day, one number.
///
/// A dashboard over a month is a dozen aggregates across every opening in it,
/// recomputed every time somebody opens the page. These rows are written once a
/// night so the history is cheap to read and survives the pruning of the raw
/// events. Today is never read from here — an operator watching a promotion
/// cannot wait until tomorrow — so the current day is always computed live.
model MetricDaily {
  /// UTC midnight. Reports must not move when the operator travels.
  day DateTime @db.Date
  key String

  /// BigInt because this is a daily total in minor units: a day's turnover
  /// past twenty-one million roubles would overflow an Int, and a metric that
  /// silently wraps is worse than no metric.
  value BigInt

  updatedAt DateTime @updatedAt

  @@id([day, key])
  @@index([key, day])
  @@map("metrics_daily")
}

model Transaction {
  id     String          @id @default(uuid()) @db.Uuid
  userId String          @db.Uuid
  type   TransactionType

  /// Signed amount: debits are negative, credits positive.
  amount Int

  /// Balance after the entry — a snapshot for audit and reconciliation.
  balanceAfter Int

  /// Reference to the originating entity (openingId, withdrawalId, PSP payment).
  referenceId String?
  comment     String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  /// The free-case gate: how much this player topped up in the last 24 hours.
  /// Narrowing by type as well is what keeps it off a player's whole history.
  @@index([userId, type, createdAt])
  @@map("transactions")
}

model Withdrawal {
  id       String             @id @default(uuid()) @db.Uuid
  userId   String             @db.Uuid
  status   WithdrawalStatus   @default(PENDING)
  provider WithdrawalProvider @default(MARKET)

  totalValue Int
  tradeUrl   String

  /// Bot channel only: one offer carries the whole request. The market channel
  /// buys each item separately, so its trade ids live on the purchases.
  botId        String? @db.Uuid
  tradeOfferId String?

  failureReason String?
  attempts      Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  completedAt DateTime?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  SteamBot?  @relation(fields: [botId], references: [id], onDelete: SetNull)

  /// What the request asked for. Permanent.
  items WithdrawalItem[]
  /// The inventory rows still pointing at this request. Transient: an item that
  /// is given back stops pointing here, which is exactly why it cannot double
  /// as the history — see WithdrawalItem. Not the same as "locked": a delivered
  /// item keeps pointing here too, it is simply WITHDRAWN rather than LOCKED.
  inventoryItems InventoryItem[]
  purchases MarketPurchase[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("withdrawals")
}

/// One line of a withdrawal request: an item the player asked to take out.
///
/// Written when the request is made and never rewritten. The obvious place to
/// read this from is `InventoryItem.withdrawalId`, and that is the trap: that
/// column says which request is holding an item *now*, and it is cleared the
/// moment the item is handed back. A request that failed would therefore list
/// nothing at all, and the player would be told "failed" with no mention of
/// what had failed. History has to be a record, not a live pointer.
model WithdrawalItem {
  id              String @id @default(uuid()) @db.Uuid
  withdrawalId    String @db.Uuid
  inventoryItemId String @db.Uuid
  itemId          String @db.Uuid

  /// Denormalised so a line stays readable after the catalogue entry is
  /// renamed, and priced as the site valued it when the request was made.
  marketHashName String
  price          Int

  createdAt DateTime @default(now())

  withdrawal    Withdrawal    @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// One line per item per request; a repeat submission cannot duplicate one.
  @@unique([withdrawalId, inventoryItemId])
  @@index([withdrawalId])
  @@map("withdrawal_items")
}

/// One skin bought on market.csgo.com for one withdrawn item.
///
/// A request for three items is three purchases from three different sellers,
/// each delivered by its own Steam offer, each able to fail on its own. That is
/// the price of holding no inventory, and it is why a withdrawal can end up
/// PARTIAL: the site has to be able to say "two arrived, one was refunded"
/// rather than pretending the request is atomic.
model MarketPurchase {
  id           String @id @default(uuid()) @db.Uuid
  withdrawalId String @db.Uuid

  /// Which market account paid for this, and the only one that can be asked
  /// about it afterwards: `get-buy-info-by-custom-id` answers for the key that
  /// made the purchase and for no other. Bound before the money moves, so a
  /// lost reply is still traceable to the account that may have been charged.
  /// Nullable only for rows made before the site had more than one account.
  accountId String? @db.Uuid

  /// Unique: an inventory item is bought once or not at all. This is the
  /// constraint that stops a retried job paying for the same skin twice.
  inventoryItemId String @unique @db.Uuid
  itemId          String @db.Uuid

  /// Denormalised: the purchase has to remain explicable after the catalogue
  /// entry is renamed or deleted.
  marketHashName String

  status MarketPurchaseStatus @default(PENDING)

  /// What the site was willing to pay, and what it actually paid — both in
  /// settlement minor units, converted from whatever the market quoted.
  maxPrice  Int
  paidPrice Int?

  /// The market's own trade stage, kept raw so support can read it against
  /// their documentation rather than against our translation of it.
  stage Int?

  /// Their id for the purchase, and the Steam offer the seller ended up sending.
  marketId     String?
  tradeOfferId String?

  failureReason String?
  attempts      Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  boughtAt    DateTime?
  deliveredAt DateTime?

  withdrawal    Withdrawal     @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  account       MarketAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([withdrawalId])
  @@index([status, createdAt])
  /// The poller's hot read: everything still open, grouped by the key that can
  /// ask about it.
  @@index([accountId, status])
  @@map("market_purchases")
}

/// One market.csgo.com account the site buys withdrawals through.
///
/// There is more than one for a reason that is not redundancy: the market
/// deletes an API key that goes over five requests a second. A single key
/// therefore caps the whole site's withdrawal throughput at a handful of
/// requests per second, and every purchase costs several — a search, a buy, and
/// a poll for as long as the seller takes. Accounts are how that ceiling is
/// raised, and each one is throttled independently because the limit is
/// counted per key.
///
/// The consequence to keep in mind is that accounts are not interchangeable
/// after the fact: a purchase can only be asked about with the key that made
/// it, and the money comes out of that account's balance.
model MarketAccount {
  id    String @id @default(uuid()) @db.Uuid
  label String

  /// AES-256-GCM under BOT_SECRETS_KEY, the same as the Steam bots' secrets,
  /// and decrypted only inside the worker. The back office never sees a key:
  /// it reads the snapshot below instead.
  encryptedApiKey String

  status MarketAccountStatus @default(OFFLINE)

  /// Written by the worker so the panel can report on an account without
  /// holding its key — the same arrangement the bot farm uses. Balance is in
  /// settlement minor units.
  balance       Int?
  currency      String?
  lastCheckedAt DateTime?
  lastError     String?

  /// The flags from `/test`, stored as sent so support can read them against
  /// the market's own documentation rather than our translation of them.
  checks Json?

  /// How many requests this account has been asked for, for a rough read on
  /// whether the pool is spreading load evenly.
  requestCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases MarketPurchase[]

  @@index([status])
  @@map("market_accounts")
}

/// One attempt to put money on a balance.
///
/// The row exists before the player reaches a checkout and survives whatever
/// happens there, which is the point: a provider that confirms a payment twice,
/// or confirms one the site never heard of, meets a record that already knows
/// its own state. Crediting is a transition of this row and nothing else.
model Payment {
  id       String        @id @default(uuid()) @db.Uuid
  userId   String        @db.Uuid
  status   PaymentStatus @default(PENDING)
  /// Which adapter created it. A string rather than an enum: adding a provider
  /// should not be a migration, and the value is only ever compared to the
  /// adapter registry at runtime.
  provider String

  /// What the player pays, and what lands on the balance — a promotion can
  /// make the second larger, and a report that could not tell them apart could
  /// not say what the promotion cost.
  amount Int
  bonus  Int @default(0)

  /// The provider's own id for this payment. Unique per provider, and the key
  /// a webhook is matched on.
  providerRef String?

  /// What the provider last said, kept verbatim for support to read. Never
  /// parsed for meaning after the fact.
  providerStatus String?
  failureReason  String?

  promoCode String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// A player handing skins to the site in exchange for balance.
///
/// The mirror image of a withdrawal, and it carries the same guarantee: the
/// valuation is frozen when the request is made. A player who is quoted 4 200
/// gets 4 200, even if the market moves while the offer sits in Steam waiting
/// for them to press Accept. Re-pricing on arrival would mean the number they
/// agreed to was never the number that mattered.
model ItemDeposit {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @db.Uuid
  status ItemDepositStatus @default(PENDING)

  /// What the whole request is worth to the player, in minor units, and the
  /// payout rate it was quoted at. The rate is recorded rather than looked up
  /// later because an operator may change it, and a report that cannot say
  /// which rate applied cannot explain the number it is showing.
  totalValue Int
  rateBps    Int

  /// Where the offer goes. Copied from the player's profile at request time —
  /// a trade URL edited mid-flight must not redirect an offer already sent.
  tradeUrl String

  botId        String? @db.Uuid
  tradeOfferId String?

  failureReason String?
  attempts      Int     @default(0)

  /// After this the offer is abandoned. Steam expires offers on its own
  /// schedule, but a request left PENDING because no bot was free would
  /// otherwise sit in the list for ever.
  expiresAt DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  completedAt DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot   SteamBot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  items ItemDepositItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("item_deposits")
}

/// One skin inside a deposit request.
///
/// The name and both prices are denormalised for the same reason a withdrawal
/// line denormalises them: this is the record of what was agreed, and it has to
/// stay readable after the catalogue is renamed or re-priced.
model ItemDepositItem {
  id        String @id @default(uuid()) @db.Uuid
  depositId String @db.Uuid

  /// The asset in the player's own Steam inventory. Unique per Steam account
  /// and not stable across trades, which is exactly why the offer has to be
  /// sent promptly after the quote.
  assetId        String
  marketHashName String

  /// The catalogue row, when the site carries this skin. Null is ordinary: a
  /// player may hand over something no case has ever contained.
  itemId String? @db.Uuid

  /// What the market said, and what the site agreed to pay for it.
  marketPrice Int
  payout      Int

  createdAt DateTime @default(now())

  deposit ItemDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  item    Item?       @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([depositId])
  @@map("item_deposit_items")
}

model SteamBot {
  id        String    @id @default(uuid()) @db.Uuid
  steamId64 String    @unique
  username  String
  label     String?
  status    BotStatus @default(OFFLINE)

  /// Secrets are stored encrypted (AES-256-GCM under BOT_SECRETS_KEY) and are
  /// decrypted only inside the bot worker.
  encryptedPassword       String
  encryptedSharedSecret   String
  encryptedIdentitySecret String

  /// A Steam inventory holds 1000 slots; keep headroom for incoming deposits.
  maxItems     Int @default(900)
  currentItems Int @default(0)

  lastOnlineAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  withdrawals  Withdrawal[]
  itemDeposits ItemDeposit[]
  inventory    BotInventoryItem[]

  @@index([status])
  @@map("steam_bots")
}

model BotInventoryItem {
  id     String @id @default(uuid()) @db.Uuid
  botId  String @db.Uuid
  itemId String @db.Uuid

  /// assetId is unique within Steam and changes every time an item moves.
  assetId    String
  isReserved Boolean @default(false)

  createdAt DateTime @default(now())

  bot  SteamBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  item Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([botId, assetId])
  @@index([itemId, isReserved])
  @@map("bot_inventory_items")
}

model AuditLog {
  id      String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid

  action     String
  entityType String
  entityId   String?

  /// Before/after snapshots — an incident cannot be investigated without them.
  before Json?
  after  Json?

  ip String?

  createdAt DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
