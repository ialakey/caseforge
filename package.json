{
  "name": "caseforge",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "ialakey <prosoulk2017@gmail.com> (https://github.com/ialakey)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ialakey/caseforge.git"
  },
  "homepage": "https://github.com/ialakey/caseforge",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:up:scale": "docker compose --profile scale up -d",
    "infra:down:scale": "docker compose --profile scale down",
    "infra:replica:init": "node tools/infra/init-replication.mjs",
    "infra:replica:status": "node tools/infra/replica-status.mjs",
    "db:migrate": "pnpm --filter @caseforge/api db:migrate",
    "db:seed": "pnpm --filter @caseforge/api db:seed",
    "db:studio": "pnpm --filter @caseforge/api db:studio",
    "setup": "pnpm install && pnpm infra:up && pnpm --filter @caseforge/shared build && pnpm db:migrate && pnpm db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test:smoke": "pnpm --filter @caseforge/api test:smoke",
    "test:smoke:contracts": "pnpm --filter @caseforge/api test:smoke:contracts",
    "test:smoke:inventory": "pnpm --filter @caseforge/api test:smoke:inventory",
    "test:smoke:bonus": "pnpm --filter @caseforge/api test:smoke:bonus",
    "test:smoke:admin": "pnpm --filter @caseforge/api test:smoke:admin",
    "test:smoke:battles": "pnpm --filter @caseforge/api test:smoke:battles",
    "test:smoke:analytics": "pnpm --filter @caseforge/api test:smoke:analytics",
    "test:smoke:payments": "pnpm --filter @caseforge/api test:smoke:payments",
    "test:smoke:giveaways": "pnpm --filter @caseforge/api test:smoke:giveaways",
    "test:smoke:security": "pnpm --filter @caseforge/api test:smoke:security",
    "test:load": "pnpm --filter @caseforge/api test:load",
    "seed:cases": "pnpm --filter @caseforge/api seed:cases",
    "grant-admin": "pnpm --filter @caseforge/api grant-admin"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  }
}
